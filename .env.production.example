# Copy this file to .env.production on the VPS and replace every change-me value.

# Public domains
# Frontend: Vercel custom domain
FRONTEND_ORIGIN=https://haushop.io.vn
FRONTEND_WWW_ORIGIN=https://www.haushop.io.vn

# Backend: VPS API domain
API_PUBLIC_ORIGIN=https://api.haushop.io.vn

# Vercel frontend environment variables
VITE_API_BASE_URL=https://api.haushop.io.vn/api
VITE_SIGNALR_URL=https://api.haushop.io.vn/hubs/chat
VITE_NOTIFICATION_HUB_URL=https://api.haushop.io.vn/hubs/notifications

# Host port used by the VPS Nginx reverse proxy
API_PORT=8080

# Optional only when serving frontend from the VPS instead of Vercel
FRONTEND_PORT=5173

# MySQL
MYSQL_DATABASE=haushop
MYSQL_ROOT_PASSWORD=
MYSQL_USER=haushop
MYSQL_PASSWORD=

# Redis
REDIS_PASSWORD=
Redis__InstanceName=haushop:

# API
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
ForwardedHeaders__Enabled=true
ConnectionStrings__DefaultConnection=
Database__ServerVersion=8.4.0-mysql
Database__ApplyMigrationsOnStartup=false
Database__MaxRetryCount=5
Database__MaxRetryDelaySeconds=10
Warmup__ProductSearch__Enabled=false
Warmup__ProductSearch__DelaySeconds=30

# JWT
Jwt__Issuer=HauShopAPI
Jwt__Audience=HauShopClient
Jwt__Key=
Jwt__AccessTokenExpirationMinutes=15
Jwt__RefreshTokenExpirationDays=7
Jwt__RefreshTokenIdleTimeoutHours=3

# CORS / URLs
Cors__AllowedOrigins__0=https://haushop.io.vn
Cors__AllowedOrigins__1=https://www.haushop.io.vn
Google__RedirectUri=https://api.haushop.io.vn/api/auth/google/callback
Google__FrontendUrl=https://haushop.io.vn
AppUrl=https://haushop.io.vn

# Google OAuth
Google__ClientId=
Google__ClientSecret=

# Email
EmailSettings__SmtpServer=smtp.gmail.com
EmailSettings__SmtpPort=587
EmailSettings__SenderEmail=
EmailSettings__SenderName=HauShop
EmailSettings__Username=
EmailSettings__Password=
EmailSettings__SecureSocketOptions=StartTls

# Cloudinary
CloudinarySettings__CloudName=
CloudinarySettings__ApiKey=
CloudinarySettings__ApiSecret=

# VnPay
VnPay__TmnCode=
VnPay__HashSecret=
VnPay__BaseUrl=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VnPay__ReturnUrl=https://haushop.io.vn/payment/vnpay-return
# Send this IPN URL to VNPAY: https://api.haushop.io.vn/api/order/vnpay-ipn

# Optional AI chat
CHATGPT_API_KEY=
