{
  "Jwt": {
    "Issuer": "HauShopAPI",
    "Audience": "HauShopClient",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7,
    "RefreshTokenIdleTimeoutHours": 3
  },
  "Google": {
    "RedirectUri": "https://localhost:7288/api/auth/google/callback",
    "FrontendUrl": "https://localhost:3000"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://localhost:3000"
    ]
  },
  "Redis": {
    "Configuration": "127.0.0.1:6379,abortConnect=false,connectRetry=1,connectTimeout=200,syncTimeout=200,asyncTimeout=200"
  },
  "Cache": {
    "ProductListTtlMinutes": 10,
    "ProductDetailTtlMinutes": 30,
    "CategoryTtlMinutes": 60,
    "HomepageTtlMinutes": 5,
    "CartTtlHours": 24,
    "OtpTtlMinutes": 15
  },
  "RateLimiting": {
    "Login": {
      "Path": "/api/auth/login",
      "PermitLimit": 5,
      "WindowSeconds": 300
    }
  },
  "Database": {
    "ServerVersion": "8.4.0-mysql",
    "ApplyMigrationsOnStartup": false,
    "MaxRetryCount": 2,
    "MaxRetryDelaySeconds": 5
  },
  "Warmup": {
    "ProductSearch": {
      "Enabled": false,
      "DelaySeconds": 30
    }
  },
  "EmailSettings": {
    "SmtpServer": "smtp.gmail.com",
    "SmtpPort": 587,
    "SenderEmail": "",
    "SenderName": "HauShop",
    "Username": "",
    "SecureSocketOptions": "StartTls"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "CloudinarySettings": {
    "CloudName": "",
    "ApiKey": "",
    "ApiSecret": ""
  },
  "VnPay": {
    "TmnCode": "",
    "HashSecret": "",
    "BaseUrl": "https://sandbox.vnpayment.vn/paymentv2/vpcpay.html",
    "ReturnUrl": "http://localhost:5173/payment/vnpay-return"
  },
  "AppUrl": "http://localhost:5173",
  "AllowedHosts": "*"
}
